# Copy to .env on the Pi (/opt/artyom-robo/.env) and add your keys, then:
#   ssh pi systemctl restart artyom-robo
# The AI control panel appears automatically once ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables 🎤 voice control (USB mic -> AssemblyAI -> Haiku sequence).
# Only needed if stt_engine = "assemblyai" in config.json.
ASSEMBLYAI_API_KEY=...

# Azure Speech (cloud TTS + STT) — used when tts_engine/stt_engine = "azure"
# (the default). Much faster TTS than local Piper. Get these from your Azure
# Speech resource. Region examples: eastus, centralindia, westeurope.
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus
